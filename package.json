{
  "name": "kirapass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "build": "next build",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "d1:create": "wrangler d1 create kirapass-db",
    "d1:migrate:local": "wrangler d1 migrations apply kirapass-db --local --config worker/wrangler.toml",
    "d1:migrate:remote": "wrangler d1 migrations apply kirapass-db --remote --config worker/wrangler.toml",
    "kirapay:webhook:get": "node scripts/get-kirapay-webhook.mjs",
    "kirapay:webhook:register": "node scripts/register-kirapay-webhook.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "^16.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251113.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
